# Copy to .env, then: docker compose up -d
# Password for the bundled Postgres. Change it before the first start; it is stored in the database volume.
POSTGRES_PASSWORD=change-me
# Seals the API keys and tokens of integrations and data exports (Slack, Segment, Amplitude, S3 ...) with AES-256-GCM.
# Set it before the first start: run `openssl rand -base64 32` in your own terminal and paste the output after the =.
# It must be the base64 of 32 random bytes. Empty: a key derived from REVENUEDOT_SIGNING_KEY is used; with neither,
# those credentials are stored unencrypted (still never shown by the API). Keep a copy with your backups: changing or
# losing it means entering the integrations' keys again.
REVENUEDOT_ENCRYPTION_KEY=
# Host port for the API and dashboard (the container always listens on 8787).
REVENUEDOT_PORT=8787
# The server image, pulled from GitHub Container Registry when missing (linux/amd64 and linux/arm64). For production,
# pin a date tag (2026.10.03) or a commit tag so a restart never picks up a build you have not tested:
# https://github.com/revenuedot/revenuedot/pkgs/container/revenuedot. Upgrade with: docker compose pull && docker compose up -d
# REVENUEDOT_IMAGE=ghcr.io/revenuedot/revenuedot:latest
# Build from source instead: `docker compose build && docker compose up -d` builds REVENUEDOT_SOURCE (GitHub main, or a local
# checkout such as ../../../revenuedot) and tags it as REVENUEDOT_IMAGE. Set REVENUEDOT_IMAGE to a name of your own, such as
# revenuedot:local, so a later `docker compose pull` does not replace your build with the published one.
# REVENUEDOT_SOURCE=https://github.com/revenuedot/revenuedot.git#main
# Optional: signs SDK responses for apps that pin this server's public key. Paste the line that
# `pnpm tsx scripts/signing-keygen.ts` prints in a revenuedot/revenuedot checkout. Empty or unset leaves signing off.
# REVENUEDOT_SIGNING_KEY=
# The address people use to open the dashboard, for links in emails, e.g. https://revenuedot.example.com.
# Empty: the address each request came in on.
# REVENUEDOT_PUBLIC_URL=
# Sign-up: only the first account (the owner) can sign up. Set to true to let anyone who can reach the dashboard
# create an account.
# REVENUEDOT_ALLOW_SIGNUP=false
# Email: password resets, team invites, email verification links and alerts. Without REVENUEDOT_SMTP_URL nothing is
# sent: every email, links included, is printed to the server log (docker compose logs revenuedot). smtp:// uses
# STARTTLS on port 587, smtps:// uses TLS on port 465. URL-encode special characters in the user or password.
# REVENUEDOT_SMTP_URL=smtp://user:password@smtp.example.com:587
# REVENUEDOT_MAIL_FROM=RevenueDot <no-reply@example.com>
# REVENUEDOT_MAIL_REPLY_TO=team@example.com
