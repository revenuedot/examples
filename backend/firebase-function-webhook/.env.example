# The webhook's signing secret. RevenueDot returns it once, when you create the webhook
# (dashboard: Integrations > Webhooks, or POST /v2/projects/{project_id}/integrations/webhooks).
# In Firebase it is a Secret Manager secret, not an .env value: firebase functions:secrets:set REVENUEDOT_WEBHOOK_SECRET
# For the emulator, put REVENUEDOT_WEBHOOK_SECRET=whsec_... in .secret.local instead.
# Optional: the Authorization header value you set on the webhook. Leave empty to skip the check.
# Copy this file to .env; Firebase reads it at deploy time.
REVENUEDOT_WEBHOOK_AUTHORIZATION=
