# Your RevenueDot server (the same URL the SDKs use as their proxy URL).
REVENUEDOT_URL=http://localhost:8787
# A secret API key (sk_...). Server-side only: never ship it in an app.
# Create one in the dashboard (API keys) or with POST /v2/projects/{project_id}/api_keys.
REVENUEDOT_SECRET_KEY=sk_replace_me
PORT=3000
# Optional, for `npm run test:live` only: lets the live test make Test Store purchases in this project.
REVENUEDOT_PROJECT_ID=
