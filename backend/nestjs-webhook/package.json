{
  "name": "revenuedot-example-nestjs-webhook",
  "private": true,
  "description": "NestJS app that receives RevenueDot webhooks and verifies their HMAC signature.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "test": "tsc && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@types/node": "22.20.4",
    "typescript": "5.9.3"
  }
}
