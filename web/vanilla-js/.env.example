# Your RevenueDot server, with no trailing slash (purchases-js rejects one).
VITE_REVENUEDOT_URL=http://localhost:8787
# The Test Store app's public key (test_...). Run examples/selfhost/docker-compose/seed.sh to get one.
# With this placeholder the page still renders preview plans; buying is off.
VITE_REVENUEDOT_API_KEY=test_replace_me
