# Your RevenueDot server, with no trailing slash (purchases-js rejects one).
NEXT_PUBLIC_REVENUEDOT_URL=http://localhost:8787
# The Test Store app's public key (test_...). Run examples/selfhost/docker-compose/seed.sh to get one.
# With this placeholder the funnel still runs and shows preview plans; buying is off.
NEXT_PUBLIC_REVENUEDOT_API_KEY=test_replace_me
# Your app's universal link. The success screen opens it with ?app_user_id=… so the app can logIn as the same customer.
NEXT_PUBLIC_OPEN_APP_URL=https://focus.example/open
