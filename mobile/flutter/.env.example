# Copy to .env, then: flutter run --dart-define-from-file=.env
# The iOS simulator reaches your computer as localhost; the Android emulator as 10.0.2.2.
REVENUEDOT_URL=http://localhost:8787
# The Test Store key (test_...) printed by selfhost/docker-compose/seed.sh. Works in debug builds only.
REVENUEDOT_API_KEY=test_replace_me
# Optional store keys for real sandbox purchases; each overrides the Test Store key on its platform.
REVENUEDOT_IOS_KEY=
REVENUEDOT_ANDROID_KEY=
