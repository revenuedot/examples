# RevenueDot: open-source, self-hostable alternative to RevenueCat. Same SDK API.
# Copy to .env.local, or run `npm run setup:test-store` to create the Test Store and write .env.local for you.
# Docs: https://revenuedot.app/docs/getting-started/quickstart

# Your RevenueDot server as the app sees it, no trailing slash.
#   RevenueDot Cloud: https://api.revenuedot.app
#   Self-hosted: iOS simulator and web http://localhost:8787, Android emulator http://10.0.2.2:8787, phone http://<your computer's LAN IP>:8787
EXPO_PUBLIC_REVENUEDOT_URL=https://api.revenuedot.app
# The Test Store app's public key (starts with test_). It works in Expo Go, simulators and the web, with no store account.
EXPO_PUBLIC_REVENUEDOT_API_KEY=test_replace_me
# Optional, for development builds that use the real stores: appl_... and goog_... keys. They win over the test_ key on that platform.
EXPO_PUBLIC_REVENUEDOT_IOS_KEY=
EXPO_PUBLIC_REVENUEDOT_ANDROID_KEY=
# The entitlement your app checks. Created as "pro" by the Test Store setup.
EXPO_PUBLIC_REVENUEDOT_ENTITLEMENT=pro
