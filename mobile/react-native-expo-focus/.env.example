# Your RevenueDot server as the phone sees it, with no trailing slash.
#   iOS simulator: http://localhost:8787   Android emulator: http://10.0.2.2:8787   Phone: http://<your computer's LAN IP>:8787
EXPO_PUBLIC_REVENUEDOT_URL=http://localhost:8787
# Public app keys. A test_ key (the Test Store app) works everywhere, including Expo Go.
EXPO_PUBLIC_REVENUEDOT_API_KEY=test_replace_me
# Optional: store keys for development builds (appl_... / goog_...). When set, they win over the test_ key on that platform.
EXPO_PUBLIC_REVENUEDOT_IOS_KEY=
EXPO_PUBLIC_REVENUEDOT_ANDROID_KEY=
